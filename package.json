{
  "name": "agent-trace-map",
  "version": "0.2.0",
  "description": "Map agent reasoning loops from JSONL traces — detect stalls, loops, and assumption failures",
  "license": "MIT",
  "type": "module",
  "bin": {
    "atm": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agents",
    "tracing",
    "observability",
    "debugging",
    "reasoning",
    "jsonl"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
